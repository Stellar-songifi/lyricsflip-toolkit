{
  "name": "@lyricsflip-toolkit/example-coin-flip",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The smallest possible game on lyricsflip-toolkit: two players stake, the server flips a coin.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@lyricsflip-toolkit/server": "0.1.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.1",
    "@stellar/stellar-sdk": "^17.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": { "^.+\\.[tj]s$": ["ts-jest", { "tsconfig": { "allowJs": true } }] },
    "transformIgnorePatterns": ["node_modules/(?!(@stellar|uint8array-extras|@exodus|@noble|axios|eventsource|smol-toml)/)"],
    "moduleNameMapper": {
      "^@lyricsflip-toolkit/server$": "<rootDir>/../../packages/server/src",
      "^@lyricsflip-toolkit/sdk$": "<rootDir>/../../packages/sdk/src"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
