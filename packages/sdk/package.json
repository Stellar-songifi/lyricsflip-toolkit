{
  "name": "@lyricsflip-toolkit/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the pvp-escrow Soroban contract, with stroop-safe amount helpers. Runs in Node and React Native.",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "dist/index.js",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(src|test)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@stellar|uint8array-extras|@exodus|@noble|axios|eventsource|smol-toml)/)"
    ],
    "testEnvironment": "node"
  }
}
