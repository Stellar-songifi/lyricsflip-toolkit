{
  "name": "@lyricsflip-toolkit/server",
  "version": "0.1.0",
  "description": "NestJS module for head-to-head stakes on Stellar: wager state machine, server-side settlement, reconciliation and SEP-10 wallet linking",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "jest --runInBand",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test:integration": "jest --config jest.integration.json --runInBand"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^0.3.20"
  },
  "dependencies": {
    "@lyricsflip-toolkit/sdk": "0.1.0",
    "@stellar/stellar-sdk": "^17.2.0",
    "class-validator": "^0.14.1"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@nestjs/typeorm": "^11.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typeorm": "^0.3.20",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "(src|test)/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "allowJs": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@stellar|uint8array-extras|@exodus|@noble|axios|eventsource|smol-toml)/)"
    ],
    "testEnvironment": "node",
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@lyricsflip-toolkit/sdk$": "<rootDir>/../sdk/src"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
