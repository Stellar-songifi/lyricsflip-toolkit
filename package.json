{
  "name": "lyricsflip-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "Settlement toolkit for head-to-head games on Stellar",
  "workspaces": [
    "packages/sdk",
    "packages/server",
    "apps/game-server",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
