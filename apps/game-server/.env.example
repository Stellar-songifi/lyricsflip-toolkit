# --- Server ---
PORT=3001
NODE_ENV=development
# Required in production. Set to your frontend origin, e.g. https://app.example.com.
# FRONTEND_URL is still read as a fallback.
CORS_ORIGIN=http://localhost:3000
# Express `trust proxy` setting. Set to a hop count (e.g. 1) or a subnet/CIDR
# (e.g. 10.0.0.0/8) when running behind a load balancer so rate limiting sees
# the real client IP. Leave empty to trust no proxy.
TRUST_PROXY=

# --- Swagger UI ---
# Serves the API docs at /api/docs. Defaults to true outside production and
# false in production (the route returns 404 when disabled).
SWAGGER_ENABLED=true
# When Swagger is enabled in production, basic auth is required. Set both to
# protect /api/docs; leave empty to serve it without auth.
SWAGGER_USER=
SWAGGER_PASSWORD=

# --- Database (primary) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lyricflip

# --- Database (optional read replica; falls back to primary if unset) ---
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_REPLICA_NAME=

# --- Game ---
# Rounds in a session before it finishes. Changing this changes session length
# with no code change; a session records the value it was created with, so
# in-flight sessions are unaffected. Omit to use the default of 10.
ROUNDS_PER_SESSION=10

# --- Auth ---
# Required. Must be at least 32 bytes and must NOT be the placeholder below.
# In production the server refuses to boot with a weak or default secret;
# outside production it logs a warning. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- Push notifications (Expo) ---
# Defaults to true in production and false elsewhere (pushes are only recorded).
EXPO_PUSH_ENABLED=false
# Only needed if "enhanced push security" is on for the Expo project.
EXPO_ACCESS_TOKEN=

# --- SEP-10 wallet login ---
# Secret key (S...) that signs login challenges. Required in production; must be
# the same on every instance. Generate one with `stellar keys generate` and keep
# it in a secrets manager. Left empty in development, a throwaway key is used.
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost

# --- Stellar settlement ---
# STELLAR_SETTLEMENT_MODE=mock keeps escrow pots in Postgres (no tokens move)
# and needs no Stellar setup. Switch to `stellar` once pvp-escrow is deployed.
STELLAR_SETTLEMENT_MODE=mock

# STELLAR_CUSTODY_MODE=non-custodial builds unsigned transactions for the
# player's wallet to sign. `custodial` is refused at boot when
# STELLAR_NETWORK=public.
STELLAR_CUSTODY_MODE=non-custodial

# The following are only read (and validated at boot) when
# STELLAR_SETTLEMENT_MODE=stellar.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Per-request HTTP timeout for RPC calls, in milliseconds. A slow or
# unresponsive RPC node would otherwise hang settlement forever and hold the
# request handler open. 0 disables the timeout.
STELLAR_RPC_HTTP_TIMEOUT_MS=15000
STELLAR_ESCROW_CONTRACT_ID=
STELLAR_TOKEN_CONTRACT_ID=
# Where the resolver key comes from: env | file | vault | aws-secrets-manager.
# Anything but `env` is re-read after STELLAR_RESOLVER_SECRET_CACHE_TTL_MS, so the
# key can be rotated without a restart (see docs/resolver-key-rotation.md).
STELLAR_RESOLVER_SECRET_SOURCE=env
STELLAR_RESOLVER_SECRET_CACHE_TTL_MS=60000
# source=env
STELLAR_RESOLVER_SECRET=
# source=file (e.g. a Kubernetes-mounted secret)
STELLAR_RESOLVER_SECRET_FILE=
# source=vault (KV v2)
VAULT_ADDR=
VAULT_TOKEN=
STELLAR_RESOLVER_SECRET_VAULT_MOUNT=secret
STELLAR_RESOLVER_SECRET_VAULT_PATH=
STELLAR_RESOLVER_SECRET_VAULT_FIELD=secret
# source=aws-secrets-manager (needs @aws-sdk/client-secrets-manager installed)
STELLAR_RESOLVER_SECRET_AWS_ID=
STELLAR_RESOLVER_SECRET_AWS_JSON_KEY=
AWS_REGION=

# --- Test-token faucet (testnet/local only; ignored on public) ---
# The stake token as CODE:ISSUER, and the secret of an account holding it.
STELLAR_STAKE_ASSET=
FAUCET_SECRET=
FAUCET_AMOUNT=100
