# --- Server ---
PORT=3001
NODE_ENV=development
# Browser origin allowed by CORS (the web game). FRONTEND_URL is still read as a fallback.
CORS_ORIGIN=http://localhost:3000

# --- Database (primary) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lyricflip

# --- Database (optional read replica; falls back to primary if unset) ---
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_REPLICA_NAME=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- Push notifications (Expo) ---
# Defaults to true in production and false elsewhere (pushes are only recorded).
EXPO_PUSH_ENABLED=false
# Only needed if "enhanced push security" is on for the Expo project.
EXPO_ACCESS_TOKEN=

# --- SEP-10 wallet login ---
# Secret key (S...) that signs login challenges. Required in production; must be
# the same on every instance. Generate one with `stellar keys generate` and keep
# it in a secrets manager. Left empty in development, a throwaway key is used.
SEP10_SIGNING_SECRET=
SEP10_HOME_DOMAIN=localhost

# --- Stellar settlement ---
# STELLAR_SETTLEMENT_MODE=mock keeps escrow pots in Postgres (no tokens move)
# and needs no Stellar setup. Switch to `stellar` once pvp-escrow is deployed.
STELLAR_SETTLEMENT_MODE=mock

# STELLAR_CUSTODY_MODE=non-custodial builds unsigned transactions for the
# player's wallet to sign. `custodial` is refused at boot when
# STELLAR_NETWORK=public.
STELLAR_CUSTODY_MODE=non-custodial

# The following are only read (and validated at boot) when
# STELLAR_SETTLEMENT_MODE=stellar.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_ESCROW_CONTRACT_ID=
STELLAR_TOKEN_CONTRACT_ID=
STELLAR_RESOLVER_SECRET=

# --- Test-token faucet (testnet/local only; ignored on public) ---
# The stake token as CODE:ISSUER, and the secret of an account holding it.
STELLAR_STAKE_ASSET=
FAUCET_SECRET=
FAUCET_AMOUNT=100
