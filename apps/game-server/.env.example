# --- Server ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database (primary) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lyricflip

# --- Database (optional read replica; falls back to primary if unset) ---
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_REPLICA_USERNAME=
DB_REPLICA_PASSWORD=
DB_REPLICA_NAME=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# --- Stellar settlement ---
# STELLAR_SETTLEMENT_MODE=mock keeps wager balances in Postgres and needs no
# Stellar setup. Switch to `stellar` once contracts are deployed.
STELLAR_SETTLEMENT_MODE=mock

# STELLAR_CUSTODY_MODE=non-custodial builds unsigned transactions for the
# player's wallet to sign. `custodial` is refused at boot when
# STELLAR_NETWORK=public.
STELLAR_CUSTODY_MODE=non-custodial

# The following are only read (and validated at boot) when
# STELLAR_SETTLEMENT_MODE=stellar.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_ESCROW_CONTRACT_ID=
STELLAR_TOKEN_CONTRACT_ID=
STELLAR_RESOLVER_SECRET=
