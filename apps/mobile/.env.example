# The game server (apps/game-server). On a device, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
# Request timeout in milliseconds (default: 30000)
EXPO_PUBLIC_API_TIMEOUT_MS=30000
# The app's wallet only works on testnet. Anything else is refused at startup.
EXPO_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
EXPO_PUBLIC_FRIENDBOT_URL=https://friendbot.stellar.org
