{
  "name": "@lyricsflip-toolkit/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "tsc --noEmit",
    "test": "jest",
    "bundle:check": "expo export --platform android --output-dir .expo-export"
  },
  "dependencies": {
    "@lyricsflip-toolkit/sdk": "0.1.0",
    "@stellar/stellar-sdk": "^17.2.0",
    "expo": "57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^2.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|@stellar|@lyricsflip-toolkit|uint8array-extras|@exodus|@noble|axios|eventsource|smol-toml)"
    ],
    "moduleNameMapper": {
      "^@lyricsflip-toolkit/sdk$": "<rootDir>/../../packages/sdk/src"
    }
  }
}
