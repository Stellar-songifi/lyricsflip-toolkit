{
  "expo": {
    "name": "LyricsFlip",
    "slug": "lyricsflip",
    "scheme": "lyricsflip",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.stellarsongifi.lyricsflip",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:lyricsflip.stellarsongifi.com"
      ]
    },
    "android": {
      "package": "com.stellarsongifi.lyricsflip",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lyricsflip.stellarsongifi.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "lyricsflip"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5B21B6"
        }
      ]
    ]
  }
}
