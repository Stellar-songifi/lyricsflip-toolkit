{
  "expo": {
    "name": "LyricsFlip",
    "slug": "lyricsflip",
    "scheme": "lyricsflip",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.stellarsongifi.lyricsflip",
      "supportsTablet": false
    },
    "android": {
      "package": "com.stellarsongifi.lyricsflip",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "lyricsflip" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "color": "#7C3AED" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
